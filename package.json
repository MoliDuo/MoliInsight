{
  "name": "moli-insight",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "schema": "npm run schema:gen -w @moli-insight/protocol",
    "schema:check": "npm run schema:check -w @moli-insight/protocol",
    "migrate:local": "npm run migrate:local -w @moli-insight/worker",
    "check": "npm run typecheck && npm run test && npm run schema:check"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
