{
  "name": "@moli-insight/worker",
  "version": "0.0.0",
  "private": true,
  "description": "The MoliInsight server: ingest, export, MCP and the retention cron, on Cloudflare Workers with D1.",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @moli-insight/dashboard",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply moli-insight --local",
    "migrate:remote": "wrangler d1 migrations apply moli-insight --remote",
    "predeploy": "npm run build -w @moli-insight/dashboard",
    "deploy": "wrangler deploy",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@moli-insight/protocol": "*",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@moli-insight/node": "*",
    "happy-dom": "^20.14.5",
    "wrangler": "^4.146.0"
  }
}
