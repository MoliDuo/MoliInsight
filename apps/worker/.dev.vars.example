# Copy to .dev.vars for `wrangler dev`. In production: `wrangler secret put <NAME>`.

# Any long random string: `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
KEY_HMAC_SECRET=change-me
SESSION_SECRET=change-me-too

# Sign-in is Authelia's. The client secret is shown once by `moli-authelia add` on xiangyu-box.
OIDC_CLIENT_SECRET=

# Local development goes through the Vite server, so the callback is on its address.
# That address must be among the client's redirect URIs: http://localhost:5173/auth/callback
PUBLIC_URL=http://localhost:5173
