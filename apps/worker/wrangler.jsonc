{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moli-insight",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // The dashboard is a static single-page app. Requests that match no worker
  // route fall through to it.
  "assets": {
    "directory": "../dashboard/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/mcp", "/healthz"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moli-insight",
      // Replace with the id printed by `wrangler d1 create moli-insight`.
      // Local development (`--local`) does not use it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Abuse control. Direct-mode keys sit inside client binaries, so the limits
  // are per key (a leaked key cannot flood the database) and per device.
  // The binding is eventually consistent per location; that is fine here.
  "ratelimits": [
    { "name": "INGEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "DEVICE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // Retention: once a day, delete expired rows in batches.
  "triggers": { "crons": ["17 3 * * *"] }
}
