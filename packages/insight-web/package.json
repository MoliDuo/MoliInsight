{
  "name": "@moli-insight/web",
  "version": "0.1.0",
  "private": true,
  "description": "MoliInsight web SDK. Zero dependencies, ESM, under 4 KB gzipped.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@moli-insight/protocol": "*",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5"
  },
  "files": [
    "dist/index.js",
    "dist/src/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build.ts"
  }
}
