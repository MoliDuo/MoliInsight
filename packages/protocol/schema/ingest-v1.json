{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "context": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "android",
            "windows",
            "macos",
            "server"
          ]
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "deviceId": {
          "type": "string",
          "pattern": "^dev_[A-Za-z0-9]{8,48}$"
        },
        "deviceClass": {
          "type": "string",
          "enum": [
            "phone",
            "tablet",
            "desktop"
          ]
        },
        "os": {
          "type": "string",
          "maxLength": 64
        },
        "client": {
          "type": "string",
          "maxLength": 64
        },
        "viewport": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "locale": {
          "type": "string",
          "maxLength": 35
        },
        "timeZone": {
          "type": "string",
          "maxLength": 64
        },
        "standalone": {
          "type": "boolean"
        }
      },
      "required": [
        "platform",
        "release"
      ]
    },
    "events": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^\\$?[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "mono": {
            "type": "number",
            "minimum": 0
          },
          "sessionId": {
            "type": "string",
            "pattern": "^ses_[A-Za-z0-9]{8,48}$"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "route": {
            "type": "string",
            "maxLength": 200
          },
          "props": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "id",
          "name",
          "occurredAt"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "sentAt",
    "context",
    "events"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://insight.moli.invalid/schema/ingest-v1.json",
  "title": "MoliInsight ingest request v1"
}
